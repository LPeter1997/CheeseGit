# Maintainer: Peter Lenkefi <lenkefi.peti at gmail dot com>
# AUR package from the release's distro tarball (built with -p:CheeseGitUpdater=false: pacman updates it).
# package.sh fills in the version and checksums and writes the PKGBUILD next to the tarballs.
pkgname=cheesegit-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='A git client for every desktop'
arch=('x86_64' 'aarch64')
url='https://github.com/LPeter1997/CheeseGit'
license=('MIT')
depends=('git' 'fontconfig' 'libx11' 'libice' 'libsm' 'openssl')
provides=('cheesegit')
conflicts=('cheesegit')
options=('!strip' '!debug')
source_x86_64=("https://github.com/LPeter1997/CheeseGit/releases/download/v${pkgver}/cheesegit-${pkgver}-linux-x64.tar.gz")
source_aarch64=("https://github.com/LPeter1997/CheeseGit/releases/download/v${pkgver}/cheesegit-${pkgver}-linux-arm64.tar.gz")
sha256sums_x86_64=('@SHA256_X64@')
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
  cd "cheesegit-${pkgver}"
  install -d "$pkgdir/usr/lib/cheesegit" "$pkgdir/usr/bin"
  cp -a lib/. "$pkgdir/usr/lib/cheesegit/"
  ln -s /usr/lib/cheesegit/CheeseGit "$pkgdir/usr/bin/cheesegit"
  cp -a share/. "$pkgdir/usr/share/"
}
